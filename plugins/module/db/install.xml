<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/gitlab/db" VERSION="20260330" COMMENT="XMLDB file for Moodle mod_gitlab"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="gitlab" COMMENT="Stores the gitlab activity module instances.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID of the course this activity is part of."/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="The name of the activity module instance"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp of when the instance was added to the course."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp of when the instance was last modified."/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Activity description."/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The format of the intro field."/>
        <!-- GitLab integration fields -->
        <FIELD NAME="group_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="GitLab group ID created or linked to this activity instance."/>
        <FIELD NAME="parent_group" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="GitLab parent group ID under which new groups/projects are created."/>
        <FIELD NAME="group_size" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Maximum number of members allowed per group for this activity."/>
        <FIELD NAME="due_date" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Deadline timestamp for the practical work submission."/>
        <FIELD NAME="reviewers" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON-encoded list of GitLab usernames assigned as reviewers for this activity."/>
        <FIELD NAME="template_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="GitLab template repository ID for this activity instance."/>
        <FIELD NAME="webhook_secret" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="GitLab webhook signature encrypted secret."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="gitlab_groups" COMMENT="Stores the gitlab groups.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="module_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID of the gitlab module this group is part of"/>
        <FIELD NAME="repository_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="GitLab group's repository ID"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_module" TYPE="foreign" FIELDS="module_id" REFTABLE="gitlab" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="gitlab_group_members" COMMENT="Stores the gitlab group members.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="group_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID of the gitlab group"/>
        <FIELD NAME="user_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID of the member user"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_group" TYPE="foreign" FIELDS="group_id" REFTABLE="gitlab_groups" REFFIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="user_id" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
