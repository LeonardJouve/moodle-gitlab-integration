{{!
    @template mod_gitlab/teacher_template

    Template for teacher template
}}

<div class="box py-3 card-columns">
<h2>{{#str}} template_teacher_template_template, mod_gitlab {{/str}}</h2>
<div class="card">
    <div class="card-body d-flex flex-column">
        <div class="d-flex align-items-center">
            <a
                role="button"
                data-bs-toggle="collapse"
                data-for="sectiontoggler"
                href="#collapsetemplate"
                aria-controls="collapsetemplate"
                aria-expanded="false"
                class="btn btn-icon me-3 icons-collapse-expand collapsed"
            >
                <span class="expanded-icon icon-no-margin p-2" title="Collapse">
                    <i class="icon fa fa-chevron-down fa-fw"></i>
                    <span class="visually-hidden">{{#str}} template_teacher_template_collapse, mod_gitlab {{/str}}</span>
                </span>
                <span class="collapsed-icon icon-no-margin p-2" title="Expand">
                    <i class="icon fa fa-chevron-right fa-fw"></i>
                    <span class="visually-hidden">{{#str}} template_teacher_template_expand, mod_gitlab {{/str}}</span>
                </span>
            </a>
            <h5 class="mb-0 flex-grow-1">
                <a class="card-title" href={{repository_url}} target="_blank">{{name}}</a>
            </h5>
        </div>
        
        <div id="collapsetemplate" class="collapse">
            <div class="d-grid gap-3 mt-3" style="grid-template-columns: 1fr auto;">
                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_teacher_template_reviewers, mod_gitlab {{/str}}</span>
                </div>
                <div class="d-flex align-items-center gap-2 justify-content-end">
                    {{#reviewers}}
                        <i class="mb-0">{{.}}</i>
                    {{/reviewers}}
                </div>
                
                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_teacher_template_due_date, mod_gitlab {{/str}}</span>
                </div>
                <div class="d-flex align-items-center justify-content-end">
                    <span class="mb-0">{{due_date}}</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_teacher_template_repository, mod_gitlab {{/str}}</span>
                </div>
                <div class="d-flex align-items-center justify-content-end">
                    <a class="btn btn-primary d-inline-flex align-items-center"
                        href="{{repository_url}}"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Repository"
                    >
                        <i class="icon fa fa-globe me-2"></i>
                        {{#str}} template_teacher_template_open, mod_gitlab {{/str}}
                    </a>
                </div>

                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_teacher_template_instructions, mod_gitlab {{/str}}</span>
                </div>
                <div class="d-flex align-items-center justify-content-end">
                    <a class="btn btn-primary d-inline-flex align-items-center"
                        href="{{instruction_url}}"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instructions"
                    >
                        <i class="icon fa fa-globe me-2"></i>
                        {{#str}} template_teacher_template_open, mod_gitlab {{/str}}
                    </a>
                </div>

                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_teacher_template_solution, mod_gitlab {{/str}}</span>
                </div>
                <div class="d-flex align-items-center justify-content-end">
                    <a class="btn btn-primary d-inline-flex align-items-center"
                        href="{{solution_url}}"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Solution"
                    >
                        <i class="icon fa fa-globe me-2"></i>
                        {{#str}} template_teacher_template_open, mod_gitlab {{/str}}
                    </a>
                </div>

                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_teacher_template_get_source, mod_gitlab {{/str}}</span>
                </div>
                <div class="d-flex align-items-center justify-content-end">
                    {{#js}}
                        require(['mod_gitlab/copy_button'], (module) => module.init("template"));
                    {{/js}}
                    
                    <div id="code-dropdown-template" class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside">Code</button>

                        <div class="dropdown-menu p-3">
                            <div class="mb-2">
                                <span>{{#str}} template_teacher_template_clone_ssh, mod_gitlab {{/str}}</span>
                                <div class="input-group input-group-sm">
                                    <input class="form-control ssh-input" value="{{ssh_url}}" readonly>
                                    <button class="btn btn-outline-primary ssh-button">
                                        <i class="icon fa fa-copy me-0"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="mb-2">
                                <span>{{#str}} template_teacher_template_clone_http, mod_gitlab {{/str}}</span>
                                <div class="input-group input-group-sm">
                                    <input class="form-control https-input" value="{{https_url}}" readonly>
                                    <button class="btn btn-outline-primary https-button">
                                        <i class="icon fa fa-copy me-0"></i>
                                    </button>
                                </div>
                            </div>

                            <hr>

                            <div>
                                <span>{{#str}} template_teacher_template_download_source, mod_gitlab {{/str}}</span>
                                <div class="d-flex gap-2 mt-1">
                                    <a class="btn btn-outline-primary d-inline-flex align-items-center text-nowrap"
                                        href="{{download_url}}"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label="ZIP"
                                    >
                                        ZIP
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>