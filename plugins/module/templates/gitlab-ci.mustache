stages:
  - verify

protect-files:
  stage: verify
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
  script:
    - git fetch origin "$CI_MERGE_REQUEST_TARGET_BRANCH_NAME"
    - git show "origin/$CI_MERGE_REQUEST_TARGET_BRANCH_NAME:.gitlab/protected-files" > /tmp/protected-files
    - git diff --name-only "origin/$CI_MERGE_REQUEST_TARGET_BRANCH_NAME...HEAD" > /tmp/changed-files
    - |
      while IFS= read -r pattern; do
        [[ -z "$pattern" || "$pattern" =~ ^# ]] && continue
        while IFS= read -r file; do
          if [[ "$file" == $pattern ]]; then
            echo "Protected file modified: $file"
            exit 1
          fi
        done < /tmp/changed-files
      done < /tmp/protected-files
    - echo "No protected files modified"
