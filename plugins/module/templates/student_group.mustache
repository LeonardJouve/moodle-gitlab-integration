{{!
    @template mod_gitlab/student_group

    Template for student group
}}

<div class="box py-3 card-columns d-flex flex-column gap-2">
    <h2>{{#str}} template_student_group_group, mod_gitlab {{/str}}</h2>
    <div class="card">
        <div class="card-body d-flex flex-column gap-2">
            <div class="d-flex align-items-center">
                <h5 class="mb-0 flex-grow-1">
                    <a class="card-title" href={{repository_url}} target="_blank">{{name}}</a>
                </h5>
                <div class="d-flex align-items-center gap-3">
                    <p class="mb-0">{{member_count}}/{{max_member}}</p>
                </div>
            </div>

            <div class="d-grid gap-3 mt-3" style="grid-template-columns: auto 1fr auto;">
                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_student_group_members, mod_gitlab {{/str}}</span>
                </div>
                <div></div>
                <div class="d-flex align-items-center gap-2">
                    {{#members}}
                        <i class="mb-0">{{.}}</i>
                    {{/members}}
                </div>

                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_student_group_repository, mod_gitlab {{/str}}</span>
                </div>
                <div></div>
                <div class="d-flex align-items-center justify-content-end">
                    <a class="btn btn-primary d-inline-flex align-items-center"
                        href="{{repository_url}}"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Repository"
                    >
                        <i class="icon fa fa-globe me-2"></i>
                        {{#str}} template_student_group_open, mod_gitlab {{/str}}
                    </a>
                </div>

                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_student_group_instructions, mod_gitlab {{/str}}</span>
                </div>
                <div></div>
                <div class="d-flex align-items-center justify-content-end">
                    <a class="btn btn-primary d-inline-flex align-items-center"
                        href="{{instruction_url}}"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instructions"
                    >
                        <i class="icon fa fa-globe me-2"></i>
                        {{#str}} template_student_group_open, mod_gitlab {{/str}}
                    </a>
                </div>

                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_student_group_feedbacks, mod_gitlab {{/str}}</span>
                </div>
                <div class="d-flex align-items-center">
                    {{#is_graded}}
                        <span class="mb-0 badge bg-success">{{#str}} template_student_group_graded, mod_gitlab {{/str}}</span>
                    {{/is_graded}}
                    {{^is_graded}}
                        <span class="mb-0 badge bg-danger">{{#str}} template_student_group_not_graded, mod_gitlab {{/str}}</span>
                    {{/is_graded}}
                </div>
                <div class="d-flex align-items-center justify-content-end">
                    <a class="btn btn-primary d-inline-flex align-items-center"
                        href="{{feedback_url}}"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Feedbacks"
                    >
                        <i class="icon fa fa-globe me-2"></i>
                        {{#str}} template_student_group_open, mod_gitlab {{/str}}
                    </a>
                </div>

                {{#has_test_result}}
                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_student_group_tests, mod_gitlab {{/str}}</span>
                </div>
                <div class="d-flex align-items-center">
                    {{#last_test_pass}}
                        <span class="d-inline-block rounded-circle border border-success border-3" style="width: 1.5em; height: 1.5em; background-color: color-mix(in srgb, var(--bs-success) 30%, white);"></span>
                    {{/last_test_pass}}
                    {{^last_test_pass}}
                        <span class="d-inline-block rounded-circle border border-danger border-3" style="width: 1.5em; height: 1.5em; background-color: color-mix(in srgb, var(--bs-danger) 30%, white);"></span>
                    {{/last_test_pass}}
                </div>
                <div class="d-flex align-items-center justify-content-end">
                    <a class="btn btn-primary d-inline-flex align-items-center"
                        href="{{test_url}}"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Tests"
                    >
                        <i class="icon fa fa-globe me-2"></i>
                        {{#str}} template_student_group_open, mod_gitlab {{/str}}
                    </a>
                </div>
                {{/has_test_result}}

                {{#has_solution}}
                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_student_group_solution, mod_gitlab {{/str}}</span>
                </div>
                <div></div>
                <div class="d-flex align-items-center justify-content-end">
                    <a class="btn btn-primary d-inline-flex align-items-center"
                        href="{{solution_url}}"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Solution"
                    >
                        <i class="icon fa fa-globe me-2"></i>
                        {{#str}} template_student_group_open, mod_gitlab {{/str}}
                    </a>
                </div>
                {{/has_solution}}
                
                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_student_group_get_source, mod_gitlab {{/str}}</span>
                </div>
                <div class="d-flex align-items-center">
                    {{#is_delayed}}
                        <span class="mb-0 badge bg-danger">{{#str}} template_student_group_overdue, mod_gitlab {{/str}} ({{delay}})</span>
                    {{/is_delayed}}
                    {{^is_delayed}}
                        <span class="mb-0 badge bg-success">{{#str}} template_student_group_on_time, mod_gitlab {{/str}}</span>
                    {{/is_delayed}}
                </div>
                <div class="d-flex align-items-center justify-content-end">
                    {{#js}}
                        require(['mod_gitlab/copy_button'], (module) => module.init("{{id}}"));
                    {{/js}}
                    
                    <div id="code-dropdown-{{id}}" class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside">Code</button>

                        <div class="dropdown-menu p-3">
                            <div class="mb-2">
                                <span>{{#str}} template_student_group_clone_ssh, mod_gitlab {{/str}}</span>
                                <div class="input-group input-group-sm">
                                    <input class="form-control ssh-input" value="{{ssh_url}}" readonly>
                                    <button class="btn btn-outline-primary ssh-button">
                                        <i class="icon fa fa-copy me-0"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="mb-2">
                                <span>{{#str}} template_student_group_clone_http, mod_gitlab {{/str}}</span>
                                <div class="input-group input-group-sm">
                                    <input class="form-control https-input" value="{{https_url}}" readonly>
                                    <button class="btn btn-outline-primary https-button">
                                        <i class="icon fa fa-copy me-0"></i>
                                    </button>
                                </div>
                            </div>

                            <hr>

                            <div>
                                <span>{{#str}} template_student_group_download_source, mod_gitlab {{/str}}</span>
                                <div class="d-flex gap-2 mt-1">
                                    <a class="btn btn-outline-primary d-inline-flex align-items-center text-nowrap"
                                        href="{{download_url}}"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label="ZIP"
                                    >
                                        ZIP
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <span class="mb-0">{{#str}} template_student_group_leave_group, mod_gitlab {{/str}}</span>
                </div>
                <div></div>
                <div class="d-flex align-items-center justify-content-end">
                    {{#js}}
                        require(['mod_gitlab/confirm_leave_modal'], (module) => module.init({groupId: {{id}}}));
                    {{/js}}

                    <button id="leave-group-{{id}}" class="btn btn-primary btn-danger">{{#str}} template_student_group_leave, mod_gitlab {{/str}}</button>
                </div>
            </div>
        </div>
    </div>
</div>