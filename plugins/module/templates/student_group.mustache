{{!
    @template mod_gitlab/student_group

    Template for student group
}}

<div class="box py-3 card-columns d-flex flex-column gap-2">
<h2>Group</h2>
<div class="card">
    <div class="card-body d-flex align-items-center">
        <h5 class="mb-0 flex-grow-1">
            <a class="card-title" href={{repository_url}} target="_blank">{{name}}</a>
        </h5>
        <div class="d-flex align-items-center gap-3">
            <p class="mb-0">{{member_count}}/{{max_member}}</p>
        </div>
    </div>
</div>
<div>
    <a href={{leave_url}} class="btn btn-primary">Leave</a>
</div>
</div>