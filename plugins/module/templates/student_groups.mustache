{{!
    @template mod_gitlab/student_groups

    Template for student groups
}}

<div class="box py-3 card-columns d-flex flex-column gap-2">
<h2>Groups</h2>
{{#groups}}
    <div class="card">
        <div class="card-body d-flex align-items-center">
            <h5 class="card-title mb-0 flex-grow-1">{{name}}</h5>
            <div class="d-flex align-items-center gap-3">
                <p class="mb-0">{{member_count}}/{{max_member}}</p>
                {{#can_join_group}}
                    <a href={{join_group_url}} class="btn btn-primary">Join</a>
                {{/can_join_group}}
            </div>
        </div>
    </div>
{{/groups}}
<div>
    <a href={{create_group_url}} class="btn btn-primary">Create</a>
</div>
</div>