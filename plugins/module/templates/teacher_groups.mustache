{{!
    @template mod_gitlab/groups

    Template for teacher groups
}}

<div class="box py-3 card-columns">
<h2>Groups</h2>
{{#groups}}
    <div class="card">
        <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center">
                <a
                    role="button"
                    data-bs-toggle="collapse"
                    data-for="sectiontoggler"
                    href="#mycollapse"
                    aria-controls="mycollapse"
                    aria-expanded="false"
                    class="btn btn-icon me-3 icons-collapse-expand collapsed"
                >
                    <span class="expanded-icon icon-no-margin p-2" title="Collapse">
                        <i class="icon fa fa-chevron-down fa-fw"></i>
                        <span class="visually-hidden">Collapse</span>
                    </span>
                    <span class="collapsed-icon icon-no-margin p-2" title="Expand">
                        <i class="icon fa fa-chevron-right fa-fw"></i>
                        <span class="visually-hidden">Expand</span>
                    </span>
                </a>
                <h5 class="card-title mb-0 flex-grow-1">{{name}}</h5>
                <div class="d-flex align-items-center gap-3">
                    <p class="mb-0">{{member_count}}/{{max_member}}</p>
                </div>
            </div>
            <div id="mycollapse" class="collapse">
                <p>test</p>
                <p>test</p>
                <p>test</p>
                <p>test</p>
            </div>
        </div>
    </div>
{{/groups}}
</div>