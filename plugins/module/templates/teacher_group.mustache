{{!
    @template mod_gitlab/teacher_group

    Template for teacher group
}}

<div class="d-flex flex-column">
    <div class="d-grid gap-3 mt-3" style="grid-template-columns: auto 1fr auto;">
        <div class="d-flex align-items-center">
            <span class="mb-0">Members</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            {{#members}}
                <i class="mb-0">{{.}}</i>
            {{/members}}
        </div>
        <div class="d-flex align-items-center justify-content-end">
            <button class="btn btn-primary d-inline-flex align-items-center">
                <i class="icon fa fa-pen me-2"></i>
                Edit
            </button>
        </div>

        <div class="d-flex align-items-center">
            <span class="mb-0">Repository</span>
        </div>
        <div></div>
        <div class="d-flex align-items-center justify-content-end">
            <a class="btn btn-primary d-inline-flex align-items-center"
                href="{{repository_url}}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Repository"
            >
                <i class="icon fa fa-globe me-2"></i>
                Open
            </a>
        </div>

        <div class="d-flex align-items-center">
            <span class="mb-0">Feedbacks</span>
        </div>
        <div class="d-flex align-items-center">
            {{#is_graded}}
                <span class="mb-0 badge bg-success">Graded</span>
            {{/is_graded}}
            {{^is_graded}}
                <span class="mb-0 badge bg-danger">Not graded</span>
            {{/is_graded}}
        </div>
        <div class="d-flex align-items-center justify-content-end">
            <a class="btn btn-primary d-inline-flex align-items-center"
                href="{{feedback_url}}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Feedbacks"
            >
                <i class="icon fa fa-globe me-2"></i>
                Open
            </a>
        </div>

        <div class="d-flex align-items-center">
            <span class="mb-0">Tests</span>
        </div>
        <div class="d-flex align-items-center">
            {{#last_test_pass}}
                <span class="d-inline-block rounded-circle border border-success border-3" style="width: 1.5em; height: 1.5em; background-color: color-mix(in srgb, var(--bs-success) 30%, white);"></span>
            {{/last_test_pass}}
            {{^last_test_pass}}
                <span class="d-inline-block rounded-circle border border-danger border-3" style="width: 1.5em; height: 1.5em; background-color: color-mix(in srgb, var(--bs-danger) 30%, white);"></span>
            {{/last_test_pass}}
        </div>
        <div class="d-flex align-items-center justify-content-end">
            <a class="btn btn-primary d-inline-flex align-items-center"
                href="{{test_url}}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Tests"
            >
                <i class="icon fa fa-globe me-2"></i>
                Open
            </a>
        </div>
        
        <div class="d-flex align-items-center">
            <span class="mb-0">Download source code</span>
        </div>
        <div class="d-flex align-items-center">
            {{#is_delayed}}
                <span class="mb-0 badge bg-danger">Overdue ({{delay}})</span>
            {{/is_delayed}}
            {{^is_delayed}}
                <span class="mb-0 badge bg-success">On time</span>
            {{/is_delayed}}
        </div>
        <div class="d-flex align-items-center justify-content-end">
            <div class="dropdown">
                <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">Code</button>

                <div class="dropdown-menu p-3 d-flex flex-column gap-2">
                    <div>
                        <span>Clone with SSH</span>
                        <div class="input-group input-group-sm">
                            <input class="form-control" value="{{ssh_url}}" readonly>
                            <button class="btn btn-outline-primary">
                                <i class="icon fa fa-copy"></i>
                            </button>
                        </div>
                    </div>

                    <div>
                        <span>Clone with HTTPS</span>
                        <div class="input-group input-group-sm">
                            <input class="form-control" value="{{https_url}}" readonly>
                            <button class="btn btn-outline-primary">
                                <i class="icon fa fa-copy"></i>
                            </button>
                        </div>
                    </div>

                    <div>
                        <span>Checkout version at due date</span>
                        <div class="input-group input-group-sm">
                            <input class="form-control" value="{{checkout_due_date}}" readonly>
                            <button class="btn btn-outline-primary">
                                <i class="icon fa fa-copy"></i>
                            </button>
                        </div>
                    </div>

                    <hr/>

                    <div>
                        <span>Download source code</span>
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary d-inline-flex align-items-center"
                                href="{{download_due_date_url}}"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Download source code"
                            >
                                <i class="icon fa fa-download me-2"></i>
                                Download
                            </a>
                            <a class="btn btn-outline-primary d-inline-flex align-items-center"
                                href="{{download_latest_url}}"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Download source code"
                            >
                                <i class="icon fa fa-download me-2"></i>
                                Download
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>